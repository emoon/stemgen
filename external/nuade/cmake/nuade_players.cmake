# Players compiled into the nuade library. Each id names players/<id>/, whose nuade_player.cmake sets
# NUADE_PLAYER_SOURCES (paths relative to that directory) and optionally NUADE_PLAYER_LIBS (libraries it needs), and
# whose vtable is `const NuadePlayer nuade_player_<id>`. A directory in NUADE_EXTRA_PLAYER_DIRS is laid out the same,
# its name is the id.
#
#   cmake -DNUADE_PLAYERS="sonix;soundmon" ..

set(NUADE_PLAYERS_DIR "${CMAKE_CURRENT_LIST_DIR}/../players")
get_filename_component(NUADE_PLAYERS_DIR "${NUADE_PLAYERS_DIR}" ABSOLUTE)

# The player directories to build, into `out`: NUADE_PLAYERS ("all" = every player in players/, or a list of ids),
# then NUADE_EXTRA_PLAYER_DIRS.
function(nuade_resolve_players out)
    if(NUADE_PLAYERS STREQUAL "all")
        file(GLOB files CONFIGURE_DEPENDS RELATIVE "${NUADE_PLAYERS_DIR}" "${NUADE_PLAYERS_DIR}/*/nuade_player.cmake")
        set(ids "")
        foreach(file IN LISTS files)
            get_filename_component(id "${file}" DIRECTORY)
            list(APPEND ids "${id}")
        endforeach()
        list(SORT ids)
    else()
        set(ids ${NUADE_PLAYERS})
    endif()
    set(dirs "")
    foreach(id IN LISTS ids)
        list(APPEND dirs "${NUADE_PLAYERS_DIR}/${id}")
    endforeach()
    foreach(dir IN LISTS NUADE_EXTRA_PLAYER_DIRS)
        get_filename_component(dir "${dir}" ABSOLUTE)
        list(APPEND dirs "${dir}")
    endforeach()
    set(${out} "${dirs}" PARENT_SCOPE)
endfunction()

function(nuade_add_players target dirs)
    set(decls "")
    set(entries "")
    foreach(dir IN LISTS dirs)
        get_filename_component(id "${dir}" NAME)
        if(NOT EXISTS "${dir}/nuade_player.cmake")
            message(FATAL_ERROR "nuade: ${dir}/nuade_player.cmake not found")
        endif()
        set(NUADE_PLAYER_SOURCES "")
        set(NUADE_PLAYER_LIBS "")
        include("${dir}/nuade_player.cmake")
        list(TRANSFORM NUADE_PLAYER_SOURCES PREPEND "${dir}/")
        target_sources(${target} PRIVATE ${NUADE_PLAYER_SOURCES})
        if(NUADE_PLAYER_LIBS)
            target_link_libraries(${target} PRIVATE ${NUADE_PLAYER_LIBS})
        endif()
        target_include_directories(${target} PRIVATE "${dir}")
        string(APPEND decls "extern const NuadePlayer nuade_player_${id};\n")
        string(APPEND entries "    &nuade_player_${id},\n")
    endforeach()
    list(LENGTH dirs count)
    # C has no zero-length arrays: the list always ends with a 0 entry, the count excludes it.
    set(content "// Generated by cmake/nuade_players.cmake from NUADE_PLAYERS. Do not edit.\n\n#include \"nuade_registry.h\"\n\n${decls}\nconst NuadePlayer* const nuade_registry_players[] = {\n${entries}    0,\n};\nconst uint32_t nuade_registry_player_count = ${count};\n")
    set(out "${CMAKE_CURRENT_BINARY_DIR}/nuade_players.c")
    # Write through a copy so the file (and the library) only changes when the list does.
    file(WRITE "${out}.tmp" "${content}")
    configure_file("${out}.tmp" "${out}" COPYONLY)
    target_sources(${target} PRIVATE "${out}")
    message(STATUS "nuade: ${count} players")
endfunction()
